FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SESSION_TYPE=filesystem
REDIS_URL=
SESSION_FILE_DIR=instance/flask_sessions
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH_MB=20
UPLOAD_FOLDER=instance/uploads
DATABASE_HOST=your-remote-mysql-host
DATABASE_PORT=3306
DATABASE_NAME=your-database-name
DATABASE_USER=your-database-user
DATABASE_PASSWORD=replace-with-your-database-password
DATABASE_SSL_CA=path/to/provider-ca.pem
DATABASE_POOL_SIZE=5
DATABASE_TEST_NAME=la_nostra_citta_test
