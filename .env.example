FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SESSION_TYPE=filesystem
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_FILE_DIR=instance/flask_sessions
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH_MB=20
UPLOAD_FOLDER=instance/uploads
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=la_nostra_citta
DATABASE_USER=la_nostra_citta_app
DATABASE_PASSWORD=replace-me
DATABASE_POOL_SIZE=5
DATABASE_TEST_NAME=la_nostra_citta_test
